generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Tenant {
  id        String   @id @default(uuid())
  name      String
  users     User[]
}
model User {
  id        String   @id @default(uuid())
  tenantId  String
  email     String   @unique
  password  String
  role      String   @default("Inspector")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}
