import openpyxl
import requests
import glob
import os

# ⚠️ حط مسار الفولدر اللي فيه ملفات الإكسيل بتاعتك هنا
FOLDER_PATH = "/root/qualitymind-mvp/excel_files" 

API_URL = "https://qualitymind-mvp.onrender.com/api"

# 1. تسجيل الدخول
print("جاري تسجيل الدخول...")
login_res = requests.post(f"{API_URL}/auth/login", json={"email": "admin@nissan.com.eg", "password": "Admin@123"})
TOKEN = login_res.json().get("access_token")
headers = {"Authorization": f"Bearer {TOKEN}", "Content-Type": "application/json"}

if not TOKEN:
    print("فشل الدخول!")
    exit()

# 2. قراءة كل ملفات الإكسيل
excel_files = glob.glob(os.path.join(FOLDER_PATH, "*.xlsx"))
print(f"تم العثور على {len(excel_files)} ملف.")

for file_path in excel_files:
    print(f"جاري معالجة: {os.path.basename(file_path)}")
    wb = openpyxl.load_workbook(file_path, data_only=True)
    
    for sheet_name in wb.sheetnames:
        sheet = wb[sheet_name]
        parts_to_upload = []
        
        # استخراج الأجزاء
        part_name_col = 2 # عمود B
        part_no_col = 11 # عمود K
        
        current_part_name = None
        current_part_no = None
        
        # البحث عن الأجزاء في الشيت
        for row in sheet.iter_rows(values_only=True):
            if row[1] and isinstance(row[1], str) and row[1].strip() and row[10] and isinstance(row[10], str):
                if "ASSY" in row[1] or "GLASS" in row[1] or "CUSH" in row[1] or "FIN" in row[1] or "HARN" in row[1] or "SEAT" in row[1]:
                    current_part_name = row[1].strip()
                    current_part_no = row[10].strip()
                    
                    # استخراج نقاط الفحص المرتبطة بالجزء ده
                    checkpoints = []
                    # بنفترض إن نقاط الفحص بتيجي بعد الجزء
                    # دي مجرد بداية ذكية، ممكن نحتاج نظبطها حسب شيتك
                    start_row = sheet.max_row + 1
                    for idx, r in enumerate(sheet.iter_rows(values_only=True)):
                        if r[1] == current_part_name and r[10] == current_part_no:
                            start_row = idx + 1
                            break
                    
                    # نقرأ نقاط الفحص اللي تحت الجزء
                    for r_idx in range(start_row, min(start_row + 20, sheet.max_row)):
                        item_check = sheet.cell(row=r_idx, column=2).value
                        key_point = sheet.cell(row=r_idx, column=11).value
                        if item_check and key_point and "فحص" in str(item_check):
                            checkpoints.append({
                                "item": str(item_check),
                                "key": str(key_point),
                                "severity": "V2" # قيمة افتراضية
                            })
                    
                    if current_part_name and current_part_no:
                        parts_to_upload.append({
                            "partName": current_part_name,
                            "partNumber": current_part_no,
                            "checkPoints": checkpoints
                        })

        if parts_to_upload:
            print(f"  -> إرسال {len(parts_to_upload)} جزء من شيت {sheet_name}...")
            res = requests.post(f"{API_URL}/parts/bulk", json=parts_to_upload, headers=headers)
            if res.status_code == 201:
                print(f"     ✅ تم الرفع بنجاح!")
            else:
                print(f"     ❌ فشل الرفع: {res.text}")

print("انتهت العملية!")
